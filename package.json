  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "files": [
    "client.js",
    "cli.js",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
