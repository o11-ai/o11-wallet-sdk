{
  "name": "@o11/sdk",
  "version": "0.1.3",
  "type": "module",
  "description": "o11 Wallet TypeScript client and o11 command",
  "license": "MIT",
  "homepage": "https://docs.o11.ai/typescript-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o11-ai/o11-wallet-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/o11-ai/o11-wallet-sdk/issues"
  },
  "publishConfig": {
